		"data:oepnv-index": "tsx scripts/build-oepnv-stop-index.ts",
		"data:kiez-scores": "tsx scripts/build-kiez-scores.ts",
		"data:aggregate": "tsx scripts/aggregate-data.ts",
		"data:aggregate-scores": "tsx scripts/aggregate-scores.ts",
		"data:rank": "tsx scripts/aggregate-ranks.ts",
		"data:comparison": "tsx scripts/aggregate-comparison.ts",
		"data:profiles": "tsx scripts/build-kiez-profiles.ts",
		"lint:profiles": "tsx scripts/lint-profiles.ts",
		"data:layer-aggregate": "tsx scripts/build-layer-aggregates.ts",
		"data:aggregate-wohnlagen": "tsx scripts/aggregate-wohnlagen.ts",
