	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.32.0",
	"scripts": {
		"dev": "vite dev",
		"prebuild": "pnpm exec svelte-kit sync && pnpm db:migrate && pnpm data:aggregate && pnpm data:aggregate-scores && pnpm data:rank && pnpm data:comparison && (pnpm data:wahl-check || (pnpm data:wahl-fetch-chunked && pnpm data:wahl-geo && pnpm data:wahl-kiez)) && pnpm data:faq && pnpm og:images -- --force",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"data:fetch": "tsx scripts/fetch-static.ts",
		"fetch:einwohner": "tsx scripts/fetch-einwohner.ts",
