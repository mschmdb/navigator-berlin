		"data:wahl-fetch-chunked": "tsx scripts/wahl-fetch-chunked.ts",
		"data:wahl-geo": "tsx scripts/build-wahl-geometries.ts",
		"data:wahl-kiez": "tsx scripts/build-wahl-kiez-aggregat.ts",
		"data:wahl-check": "tsx scripts/check-wahl-data.ts",
		"lint:wahl": "tsx scripts/lint-wahl-editorial.ts",
		"lint:cross-layer-templates": "tsx scripts/lint-cross-layer-templates.ts",
		"data:faq": "tsx scripts/render-faq.ts",
		"webmcp:manifest": "tsx scripts/build-webmcp-manifest.ts",
		"og:images": "tsx scripts/generate-og-images.ts",
		"og:all": "pnpm og:images",
		"logo:pixel": "tsx scripts/generate-pixel-logo.ts",
		"indexnow:ping": "tsx scripts/indexnow-ping.ts",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx scripts/db/migrate.ts",
		"publish-update": "tsx scripts/publish-update/main.ts",
		"doc:pipelines": "tsx scripts/generate-data-flow-doc.ts",
		"doc:story-map": "tsx scripts/generate-story-map.ts"
