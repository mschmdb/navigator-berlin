# Geocoding-Proxy (Story 1.5)
# Default: https://nominatim.openstreetmap.org. Self-hosted Nominatim als Phase-2-Migration.
NOMINATIM_ENDPOINT=https://nominatim.openstreetmap.org

# Postgres-Aggregat-DB (Story 2.0)
# Lokale Homebrew-Postgres 17. Setup-Steps: docs/runbooks/local-postgres-setup.md
DATABASE_URL=postgres://app:app@127.0.0.1:5432/navigator_dev

# Claude-API-Key fürs LLM-Authoring der Kiez-Profile (nur für `pnpm data:profiles` nötig)
CLAUDE_API_KEY=

# IndexNow-Push an Bing (Story 5.9)
# 32-hex Key. Production-Wert via Coolify-ENV. Runbook: docs/runbooks/indexnow-deploy-ping.md
INDEXNOW_KEY=
